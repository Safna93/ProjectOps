@page "/projects"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using System.Net.Http.Headers
@using System.Net
@using ProjectOps.Web.Models
@using ProjectOps.Web.Services
@inject HttpClient HttpClient
@inject AuthService AuthService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<PageTitle>Projects</PageTitle>

<div class="d-flex justify-content-between align-items-center">
    <h1>Projects</h1>
    <button type="button" class="btn btn-outline-secondary" @onclick="Logout">Logout</button>
</div>

<div class="row g-3 align-items-end mb-4">
    <div class="col-md-3">
        <label class="form-label" for="project-search">Search</label>
        <InputText id="project-search" class="form-control" @bind-Value="searchText"
                   placeholder="Project code, name, or client" />
    </div>
    <div class="col-md-2">
        <label class="form-label" for="project-status-filter">Status</label>
        <InputText id="project-status-filter" class="form-control" @bind-Value="statusFilter"
                   placeholder="Exact status, for example Active" />
    </div>
    <div class="col-md-3">
        <label class="form-label" for="project-sort-by">Sort By</label>
        <InputSelect id="project-sort-by" class="form-select" @bind-Value="sortBy">
            <option value="ProjectCode">Project Code</option>
            <option value="ProjectName">Project Name</option>
            <option value="ClientName">Client Name</option>
            <option value="Status">Status</option>
            <option value="CreatedAt">Created Date</option>
        </InputSelect>
    </div>
    <div class="col-md-2">
        <label class="form-label" for="project-sort-direction">Sort Direction</label>
        <InputSelect id="project-sort-direction" class="form-select" @bind-Value="sortDirection">
            <option value="asc">Ascending</option>
            <option value="desc">Descending</option>
        </InputSelect>
    </div>
    <div class="col-md-auto">
        <button type="button" class="btn btn-primary me-2" @onclick="ApplyFilters">Search</button>
        <button type="button" class="btn btn-outline-secondary" @onclick="ClearFilters">Clear</button>
    </div>
</div>

@if (isAdmin)
{
    <EditForm Model="projectForm" OnValidSubmit="SaveProject">
        <DataAnnotationsValidator />

        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <label class="form-label" for="project-code">Project Code</label>
                <InputText id="project-code" class="form-control" @bind-Value="projectForm.ProjectCode" />
                <ValidationMessage For="@(() => projectForm.ProjectCode)" />
            </div>
            <div class="col-md-3">
                <label class="form-label" for="project-name">Project Name</label>
                <InputText id="project-name" class="form-control" @bind-Value="projectForm.ProjectName" />
                <ValidationMessage For="@(() => projectForm.ProjectName)" />
            </div>
            <div class="col-md-3">
                <label class="form-label" for="client-name">Client Name</label>
                <InputText id="client-name" class="form-control" @bind-Value="projectForm.ClientName" />
                <ValidationMessage For="@(() => projectForm.ClientName)" />
            </div>
            <div class="col-md-3">
                <label class="form-label" for="status">Status</label>
                <InputText id="status" class="form-control" @bind-Value="projectForm.Status" />
                <ValidationMessage For="@(() => projectForm.Status)" />
            </div>
        </div>

        <button type="submit" class="btn btn-primary" disabled="@isSaving">
            @(isEditMode ? "Update Project" : "Create Project")
        </button>

        @if (isEditMode)
        {
            <button type="button" class="btn btn-secondary ms-2" @onclick="ResetForm">Cancel</button>
        }
    </EditForm>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger mt-3" role="alert">@errorMessage</div>
}

@if (projects is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table table-striped mt-4">
        <thead>
            <tr>
                <th>Project Code</th>
                <th>Project Name</th>
                <th>Client Name</th>
                <th>Status</th>
                <th>Created By</th>
                <th>Created At</th>
                <th>Updated By</th>
                <th>Updated At</th>
                <th>Document</th>
                @if (isAdmin)
                {
                    <th>Actions</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var project in projects)
            {
                <tr>
                    <td>@project.ProjectCode</td>
                    <td>@project.ProjectName</td>
                    <td>@project.ClientName</td>
                    <td>@project.Status</td>
                    <td>@(string.IsNullOrWhiteSpace(project.CreatedBy) ? "-" : project.CreatedBy)</td>
                    <td>@(project.CreatedAt == default ? "-" : project.CreatedAt.ToString("yyyy-MM-dd HH:mm 'UTC'"))</td>
                    <td>@(string.IsNullOrWhiteSpace(project.UpdatedBy) ? "-" : project.UpdatedBy)</td>
                    <td>@(project.UpdatedAt is null ? "-" : project.UpdatedAt.Value.ToString("yyyy-MM-dd HH:mm 'UTC'"))</td>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(project.DocumentFileName))
                        {
                            <div>@project.DocumentFileName</div>
                            <button type="button" class="btn btn-sm btn-outline-secondary mt-1" @onclick="() => DownloadDocument(project)">
                                Download / View
                            </button>
                        }
                        else
                        {
                            <span>-</span>
                        }

                        @if (isAdmin)
                        {
                            <div class="mt-2">
                                <InputFile accept=".pdf,application/pdf" OnChange="@(args => SelectDocument(project.Id, args))" />
                                <button type="button" class="btn btn-sm btn-outline-primary mt-1"
                                        disabled="@(!selectedDocuments.ContainsKey(project.Id))"
                                        @onclick="() => UploadDocument(project.Id)">
                                    Upload PDF
                                </button>
                            </div>
                        }
                    </td>
                    @if (isAdmin)
                    {
                        <td>
                            <button type="button" class="btn btn-sm btn-outline-primary me-2" @onclick="() => EditProject(project)">Edit</button>
                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeleteProject(project.Id)">Delete</button>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private const long MaxDocumentSize = 5 * 1024 * 1024;
    private List<Project>? projects;
    private Project projectForm = new();
    private readonly Dictionary<int, IBrowserFile> selectedDocuments = new();
    private bool isEditMode;
    private bool isAdmin;
    private bool isSaving;
    private string? errorMessage;
    private string searchText = string.Empty;
    private string statusFilter = string.Empty;
    private string sortBy = "ProjectCode";
    private string sortDirection = "asc";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        if (!await AuthService.IsAuthenticatedAsync())
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        isAdmin = await AuthService.IsAdminAsync();
        await LoadProjects();
        StateHasChanged();
    }

    private async Task LoadProjects()
    {
        try
        {
            var queryParameters = new List<string>();
            if (!string.IsNullOrWhiteSpace(searchText))
            {
                queryParameters.Add($"search={Uri.EscapeDataString(searchText.Trim())}");
            }

            if (!string.IsNullOrWhiteSpace(statusFilter))
            {
                queryParameters.Add($"status={Uri.EscapeDataString(statusFilter.Trim())}");
            }

            queryParameters.Add($"sortBy={Uri.EscapeDataString(sortBy)}");
            queryParameters.Add($"sortDirection={Uri.EscapeDataString(sortDirection)}");

            var requestUri = queryParameters.Count == 0
                ? "api/projects"
                : $"api/projects?{string.Join("&", queryParameters)}";

            using var request = await CreateAuthorizedRequest(HttpMethod.Get, requestUri);
            if (request is null)
            {
                return;
            }

            var response = await HttpClient.SendAsync(request);
            if (await RedirectIfUnauthorized(response))
            {
                return;
            }

            response.EnsureSuccessStatusCode();
            projects = await response.Content.ReadFromJsonAsync<List<Project>>() ?? [];
        }
        catch (HttpRequestException)
        {
            projects = [];
            errorMessage = "The projects could not be loaded from the API.";
        }
    }

    private async Task ApplyFilters()
    {
        await LoadProjects();
    }

    private async Task ClearFilters()
    {
        searchText = string.Empty;
        statusFilter = string.Empty;
        sortBy = "ProjectCode";
        sortDirection = "asc";
        await LoadProjects();
    }

    private async Task SaveProject()
    {
        errorMessage = null;
        isSaving = true;

        try
        {
            HttpResponseMessage response;

            if (isEditMode)
            {
                using var request = await CreateAuthorizedRequest(
                    HttpMethod.Put,
                    $"api/projects/{projectForm.Id}",
                    new
                    {
                        projectForm.ProjectCode,
                        projectForm.ProjectName,
                        projectForm.ClientName,
                        projectForm.Status
                    });
                if (request is null)
                {
                    return;
                }

                response = await HttpClient.SendAsync(request);
            }
            else
            {
                using var request = await CreateAuthorizedRequest(
                    HttpMethod.Post,
                    "api/projects",
                    new
                    {
                        projectForm.ProjectCode,
                        projectForm.ProjectName,
                        projectForm.ClientName,
                        projectForm.Status
                    });
                if (request is null)
                {
                    return;
                }

                response = await HttpClient.SendAsync(request);
            }

            if (await RedirectIfUnauthorized(response))
            {
                return;
            }

            response.EnsureSuccessStatusCode();
            ResetForm();
            await LoadProjects();
        }
        catch (HttpRequestException)
        {
            errorMessage = "The project could not be saved.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void EditProject(Project project)
    {
        projectForm = new Project
        {
            Id = project.Id,
            ProjectCode = project.ProjectCode,
            ProjectName = project.ProjectName,
            ClientName = project.ClientName,
            Status = project.Status
        };
        isEditMode = true;
        errorMessage = null;
    }

    private async Task DeleteProject(int id)
    {
        errorMessage = null;

        try
        {
            using var request = await CreateAuthorizedRequest(
                HttpMethod.Delete,
                $"api/projects/{id}");
            if (request is null)
            {
                return;
            }

            var response = await HttpClient.SendAsync(request);
            if (await RedirectIfUnauthorized(response))
            {
                return;
            }

            response.EnsureSuccessStatusCode();

            if (projectForm.Id == id)
            {
                ResetForm();
            }

            await LoadProjects();
        }
        catch (HttpRequestException)
        {
            errorMessage = "The project could not be deleted.";
        }
    }

    private void SelectDocument(int projectId, InputFileChangeEventArgs args)
    {
        selectedDocuments[projectId] = args.File;
        errorMessage = null;
    }

    private async Task UploadDocument(int projectId)
    {
        if (!selectedDocuments.TryGetValue(projectId, out var file))
        {
            return;
        }

        errorMessage = null;

        try
        {
            await using var fileStream = file.OpenReadStream(MaxDocumentSize);
            using var fileContent = new StreamContent(fileStream);
            fileContent.Headers.ContentType = new MediaTypeHeaderValue(file.ContentType);

            using var formContent = new MultipartFormDataContent();
            formContent.Add(fileContent, "file", Path.GetFileName(file.Name));

            using var request = await CreateAuthorizedRequest(
                HttpMethod.Post,
                $"api/projects/{projectId}/document",
                formContent);
            if (request is null)
            {
                return;
            }

            using var response = await HttpClient.SendAsync(request);
            if (await RedirectIfUnauthorized(response))
            {
                return;
            }

            if (response.StatusCode == HttpStatusCode.RequestEntityTooLarge)
            {
                errorMessage = "The PDF must be 5 MB or smaller.";
                return;
            }

            response.EnsureSuccessStatusCode();
            selectedDocuments.Remove(projectId);
            await LoadProjects();
        }
        catch (IOException)
        {
            errorMessage = "Select a PDF file that is 5 MB or smaller.";
        }
        catch (HttpRequestException)
        {
            errorMessage = "The document could not be uploaded. Only PDF files are allowed.";
        }
    }

    private async Task DownloadDocument(Project project)
    {
        errorMessage = null;

        try
        {
            using var request = await CreateAuthorizedRequest(
                HttpMethod.Get,
                $"api/projects/{project.Id}/document");
            if (request is null)
            {
                return;
            }

            using var response = await HttpClient.SendAsync(request);
            if (await RedirectIfUnauthorized(response))
            {
                return;
            }

            if (response.StatusCode == HttpStatusCode.NotFound)
            {
                errorMessage = "The project document could not be found.";
                return;
            }

            response.EnsureSuccessStatusCode();
            var fileName = response.Content.Headers.ContentDisposition?.FileNameStar
                ?? response.Content.Headers.ContentDisposition?.FileName?.Trim('"')
                ?? project.DocumentFileName
                ?? "project-document.pdf";

            await using var fileStream = await response.Content.ReadAsStreamAsync();
            using var streamReference = new DotNetStreamReference(fileStream);
            await JSRuntime.InvokeVoidAsync("downloadFileFromStream", fileName, streamReference);
        }
        catch (HttpRequestException)
        {
            errorMessage = "The document could not be downloaded.";
        }
    }

    private void ResetForm()
    {
        projectForm = new Project();
        isEditMode = false;
    }

    private async Task<HttpRequestMessage?> CreateAuthorizedRequest(
        HttpMethod method,
        string requestUri,
        object? content = null)
    {
        var httpContent = content is null ? null : JsonContent.Create(content);
        return await CreateAuthorizedRequest(method, requestUri, httpContent);
    }

    private async Task<HttpRequestMessage?> CreateAuthorizedRequest(
        HttpMethod method,
        string requestUri,
        HttpContent? content)
    {
        var token = await AuthService.GetTokenAsync();
        if (string.IsNullOrWhiteSpace(token))
        {
            NavigationManager.NavigateTo("/login");
            return null;
        }

        var request = new HttpRequestMessage(method, requestUri);
        request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);

        request.Content = content;

        return request;
    }

    private async Task<bool> RedirectIfUnauthorized(HttpResponseMessage response)
    {
        if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            await AuthService.LogoutAsync();
            NavigationManager.NavigateTo("/login");
            return true;
        }

        return false;
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("/login");
    }
}