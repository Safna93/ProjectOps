@page "/projects"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using System.Net.Http.Headers
@using ProjectOps.Web.Models
@using ProjectOps.Web.Services
@inject HttpClient HttpClient
@inject AuthService AuthService
@inject NavigationManager NavigationManager

<PageTitle>Projects</PageTitle>

<div class="d-flex justify-content-between align-items-center">
    <h1>Projects</h1>
    <button type="button" class="btn btn-outline-secondary" @onclick="Logout">Logout</button>
</div>

<EditForm Model="projectForm" OnValidSubmit="SaveProject">
    <DataAnnotationsValidator />

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <label class="form-label" for="project-code">Project Code</label>
            <InputText id="project-code" class="form-control" @bind-Value="projectForm.ProjectCode" />
            <ValidationMessage For="@(() => projectForm.ProjectCode)" />
        </div>
        <div class="col-md-3">
            <label class="form-label" for="project-name">Project Name</label>
            <InputText id="project-name" class="form-control" @bind-Value="projectForm.ProjectName" />
            <ValidationMessage For="@(() => projectForm.ProjectName)" />
        </div>
        <div class="col-md-3">
            <label class="form-label" for="client-name">Client Name</label>
            <InputText id="client-name" class="form-control" @bind-Value="projectForm.ClientName" />
            <ValidationMessage For="@(() => projectForm.ClientName)" />
        </div>
        <div class="col-md-3">
            <label class="form-label" for="status">Status</label>
            <InputText id="status" class="form-control" @bind-Value="projectForm.Status" />
            <ValidationMessage For="@(() => projectForm.Status)" />
        </div>
    </div>

    <button type="submit" class="btn btn-primary" disabled="@isSaving">
        @(isEditMode ? "Update Project" : "Create Project")
    </button>

    @if (isEditMode)
    {
        <button type="button" class="btn btn-secondary ms-2" @onclick="ResetForm">Cancel</button>
    }
</EditForm>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger mt-3" role="alert">@errorMessage</div>
}

@if (projects is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table table-striped mt-4">
        <thead>
            <tr>
                <th>Project Code</th>
                <th>Project Name</th>
                <th>Client Name</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var project in projects)
            {
                <tr>
                    <td>@project.ProjectCode</td>
                    <td>@project.ProjectName</td>
                    <td>@project.ClientName</td>
                    <td>@project.Status</td>
                    <td>
                        <button type="button" class="btn btn-sm btn-outline-primary me-2" @onclick="() => EditProject(project)">Edit</button>
                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => DeleteProject(project.Id)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Project>? projects;
    private Project projectForm = new();
    private bool isEditMode;
    private bool isSaving;
    private string? errorMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        if (!await AuthService.IsAuthenticatedAsync())
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        await LoadProjects();
        StateHasChanged();
    }

    private async Task LoadProjects()
    {
        try
        {
            using var request = await CreateAuthorizedRequest(HttpMethod.Get, "http://localhost:5103/api/projects");
            if (request is null)
            {
                return;
            }

            var response = await HttpClient.SendAsync(request);
            if (await RedirectIfUnauthorized(response))
            {
                return;
            }

            response.EnsureSuccessStatusCode();
            projects = await response.Content.ReadFromJsonAsync<List<Project>>() ?? [];
        }
        catch (HttpRequestException)
        {
            projects = [];
            errorMessage = "The projects could not be loaded from the API.";
        }
    }

    private async Task SaveProject()
    {
        errorMessage = null;
        isSaving = true;

        try
        {
            HttpResponseMessage response;

            if (isEditMode)
            {
                using var request = await CreateAuthorizedRequest(
                    HttpMethod.Put,
                    $"http://localhost:5103/api/projects/{projectForm.Id}",
                    projectForm);
                if (request is null)
                {
                    return;
                }

                response = await HttpClient.SendAsync(request);
            }
            else
            {
                using var request = await CreateAuthorizedRequest(
                    HttpMethod.Post,
                    "http://localhost:5103/api/projects",
                    projectForm);
                if (request is null)
                {
                    return;
                }

                response = await HttpClient.SendAsync(request);
            }

            if (await RedirectIfUnauthorized(response))
            {
                return;
            }

            response.EnsureSuccessStatusCode();
            ResetForm();
            await LoadProjects();
        }
        catch (HttpRequestException)
        {
            errorMessage = "The project could not be saved.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void EditProject(Project project)
    {
        projectForm = new Project
        {
            Id = project.Id,
            ProjectCode = project.ProjectCode,
            ProjectName = project.ProjectName,
            ClientName = project.ClientName,
            Status = project.Status
        };
        isEditMode = true;
        errorMessage = null;
    }

    private async Task DeleteProject(int id)
    {
        errorMessage = null;

        try
        {
            using var request = await CreateAuthorizedRequest(
                HttpMethod.Delete,
                $"http://localhost:5103/api/projects/{id}");
            if (request is null)
            {
                return;
            }

            var response = await HttpClient.SendAsync(request);
            if (await RedirectIfUnauthorized(response))
            {
                return;
            }

            response.EnsureSuccessStatusCode();

            if (projectForm.Id == id)
            {
                ResetForm();
            }

            await LoadProjects();
        }
        catch (HttpRequestException)
        {
            errorMessage = "The project could not be deleted.";
        }
    }

    private void ResetForm()
    {
        projectForm = new Project();
        isEditMode = false;
    }

    private async Task<HttpRequestMessage?> CreateAuthorizedRequest(
        HttpMethod method,
        string requestUri,
        object? content = null)
    {
        var token = await AuthService.GetTokenAsync();
        if (string.IsNullOrWhiteSpace(token))
        {
            NavigationManager.NavigateTo("/login");
            return null;
        }

        var request = new HttpRequestMessage(method, requestUri);
        request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);

        if (content is not null)
        {
            request.Content = JsonContent.Create(content);
        }

        return request;
    }

    private async Task<bool> RedirectIfUnauthorized(HttpResponseMessage response)
    {
        if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            await AuthService.LogoutAsync();
            NavigationManager.NavigateTo("/login");
            return true;
        }

        return false;
    }

    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("/login");
    }
}