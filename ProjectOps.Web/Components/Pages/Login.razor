@page "/login"
@rendermode InteractiveServer
@using System.Net
@using System.Net.Http.Json
@using ProjectOps.Web.Models
@using ProjectOps.Web.Services
@inject HttpClient HttpClient
@inject AuthService AuthService
@inject NavigationManager NavigationManager

<PageTitle>Login</PageTitle>

<h1>Login</h1>

<EditForm Model="loginRequest" OnValidSubmit="LoginAsync">
    <div class="mb-3">
        <label class="form-label" for="username">Username</label>
        <InputText id="username" class="form-control" @bind-Value="loginRequest.Username" />
    </div>

    <div class="mb-3">
        <label class="form-label" for="password">Password</label>
        <InputText id="password" type="password" class="form-control" @bind-Value="loginRequest.Password" />
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    <button type="submit" class="btn btn-primary" disabled="@isLoggingIn">
        @(isLoggingIn ? "Logging in..." : "Login")
    </button>
</EditForm>

@code {
    private readonly LoginRequest loginRequest = new();
    private bool isLoggingIn;
    private string? errorMessage;

    private async Task LoginAsync()
    {
        errorMessage = null;
        isLoggingIn = true;

        try
        {
            var response = await HttpClient.PostAsJsonAsync(
          "http://localhost:5103/api/Auth/login", loginRequest);
            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                errorMessage = "Invalid username or password.";
                return;
            }

            response.EnsureSuccessStatusCode();
            var loginResponse = await response.Content.ReadFromJsonAsync<LoginResponse>();

            if (loginResponse is null || string.IsNullOrWhiteSpace(loginResponse.Token))
            {
                errorMessage = "The API returned an invalid login response.";
                return;
            }

            await AuthService.StoreTokenAsync(loginResponse.Token);
            NavigationManager.NavigateTo("/projects");
        }
        catch (HttpRequestException)
        {
            errorMessage = "The API could not be reached.";
        }
        finally
        {
            isLoggingIn = false;
        }
    }
}